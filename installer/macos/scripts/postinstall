#!/bin/bash

set -euo pipefail

SYSTEM_INSTALL_ROOT="/Library/Application Support/WebBT Server for Firefox"
SYSTEM_MANIFEST_DIR="/Library/Application Support/Mozilla/NativeMessagingHosts"
USER_MANIFEST_DIR="$HOME/Library/Application Support/Mozilla/NativeMessagingHosts"

if [[ "$DSTROOT" == "$SYSTEM_INSTALL_ROOT" ]]; then
  manifest_dir="$SYSTEM_MANIFEST_DIR"
else
  manifest_dir="$USER_MANIFEST_DIR"
fi

mkdir -p "$manifest_dir"

cat > "$manifest_dir/webbt.server.json" <<EOF
{
  "name": "webbt.server",
  "description": "Web Bluetooth Extension Server",
  "path": "$DSTROOT/BLEServer",
  "type": "stdio",
  "allowed_extensions": [
    "webbt@ff"
  ]
}
EOF
